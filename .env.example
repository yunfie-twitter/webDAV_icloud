ICLOUD_APPLE_ID=you@example.com
ICLOUD_PASSWORD=
ICLOUD_WEBDAV_PASSWORD=replace-with-a-long-random-password
POSTGRES_PASSWORD=replace-with-a-long-random-password
ICLOUD_AUTH_METHOD=sms

# OAuth client secret with auth_keys scope. OAuth nodes are ephemeral by
# default, so keep ?ephemeral=false. The advertised tag must be allowed.
TS_AUTHKEY=tskey-client-example?ephemeral=false
TS_HOSTNAME=icloud-gw-a1b2c3d4
TS_CERT_DOMAIN=icloud-gw-a1b2c3d4.example-tailnet.ts.net
# Optional direct HTTPS endpoint. Enable it with scripts/enable-ip-access.sh.
TS_IP_ADDRESS=
TS_EXTRA_ARGS=--advertise-tags=tag:icloud-webdav
TS_SERVE_CONFIG_DIR=./tailscale-config
MTLS_PKI_DIR=./pki
CADDY_IP_SITES_DIR=./caddy-ip-sites

# Optional temporary SFTP adapter (key authentication only).
SFTP_CONFIG_DIR=./sftp
SFTP_CACHE_SIZE=1G

# Optional temporary implicit FTPS adapter. Use a password different from the
# WebDAV password. FTPS also requires TS_IP_ADDRESS above.
ICLOUD_FTPS_PASSWORD=replace-with-an-independent-long-random-password
FTPS_CACHE_SIZE=1G

# Preferred anonymous SMB adapter. Plaintext VFS cache is held in tmpfs only.
SMB_CACHE_SIZE=2G
# Used only with compose.smb-host.yaml. Prefer the server's trusted-LAN IPv4
# instead of 0.0.0.0 when the address is stable.
SMB_HOST_BIND=0.0.0.0
SMB_HOST_PORT=445

# Linux reference platform
KEYBROKER_SOCKET=/run/icloud-keybroker/keybroker.sock
KEYBROKER_SOCKET_DIR=/run/icloud-keybroker
KEYBROKER_GID=10001

# Windows Docker Desktop override (host paths)
KEYBROKER_CA=C:\ProgramData\iCloudKeyBroker\pki\ca.pem
KEYBROKER_CLIENT_CERT=C:\ProgramData\iCloudKeyBroker\pki\gateway.pem
KEYBROKER_CLIENT_KEY=C:\ProgramData\iCloudKeyBroker\pki\gateway-key.pem
